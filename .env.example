# ─────────────────────────────────────────────────────────────
# Khushi's Store — environment variables
# Copy this file to ".env.local" and fill in the values.
# The storefront runs with built-in sample products even if these
# are left blank, so you can preview the site before setting up Sanity.
# ─────────────────────────────────────────────────────────────

# Sanity CMS (the admin dashboard where products are managed).
# Get these after creating a free project at https://www.sanity.io/
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Razorpay (payments) — add these once you're ready to accept payments.
# From your Razorpay dashboard: Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
