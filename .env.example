# ─────────────────────────────────────────────────────────────
# Khushi's Store — environment variables
# Copy this file to ".env.local" and fill in the values.
# The storefront still has built-in sample products as a safe fallback.
# ─────────────────────────────────────────────────────────────

# Supabase — authentication, customer data and product catalogue.
# Both values are safe to expose to the browser when Row Level Security is enabled.
# Get them from Supabase Project → Connect / API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay (payments) — add these once you're ready to accept payments.
# From your Razorpay dashboard: Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
